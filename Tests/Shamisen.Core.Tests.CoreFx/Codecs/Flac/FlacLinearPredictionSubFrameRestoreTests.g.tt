// <auto-generated />
using System;
using System.Collections.Generic;

using NUnit.Framework;

using Shamisen.Codecs.Flac.SubFrames;

namespace Shamisen.Core.Tests.CoreFx.Codecs.Flac
{
    [TestFixture]
    public partial class FlacLinearPredictionSubFrameRestoreTests
    {
<#  foreach (var item in intrinsicsNames)
    {
        var additionalParameters = (item.additionalParameters?.Count ?? 0) > 0 ? $", {string.Join(", ", item.additionalParameters)}" : "";
#>

        [TestCaseSource(nameof(RestoreSignalTestCaseSource))]
        public void RestoreSignal<#=item.name#>RestoresCorrectly(int order, int shiftsNeeded, int bitsPerSample, int quantizedPrecision, int outputLength)
        {
            if (!FlacLinearPredictionSubFrame.<#=item.className#>.Is<#=item.name#>Supported) Assert.Ignore("<#=item.name#> is not supported!");
            var data = new TestData(order, shiftsNeeded, bitsPerSample, quantizedPrecision, outputLength);
            var outputBuffer = new int[outputLength + order];
            data.WarmupSignal.CopyTo(outputBuffer);
            data.Residuals.CopyTo(outputBuffer.AsSpan(data.Order));
            FlacLinearPredictionSubFrame.<#=item.className#>.RestoreSignal<#=item.name#>(data.GenerateParameters(outputBuffer)<#=additionalParameters#>);
            Assert.That(outputBuffer, Is.EqualTo(data.ExpectedOutput));
        }
<#  }
#>
    }
}