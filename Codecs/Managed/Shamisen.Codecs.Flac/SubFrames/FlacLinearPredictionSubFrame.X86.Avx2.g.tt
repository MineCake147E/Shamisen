    const string SuffixSse41 = "Sse41";
    const string SuffixAvx2 = "Avx2";
    const string SuffixIfma = "Ifma";
    const string SuffixIfmaV256 = "IfmaV256";
    const string SuffixIfmaV512 = "IfmaV512";

    const bool TestSse41OverAvx2 = false;
    var c = Enumerable.Range(1, 32);
    List<FlacLinearPredictionVariantInfo> lowOrderVariants = [
        new(0x4040_0003_801f_0000ul, $"64{SuffixSse41}")
    ];
    List<FlacLinearPredictionVariantInfo> midOrderVariants = [
        new(0x4040_0003_d000_0000ul, $"64{SuffixAvx2}"),
    ];
    List<FlacLinearPredictionVariantInfo> highOrderVariants = [
        new (0x2020_0003_d000_0000ul, $"32{SuffixAvx2}"),
        new (0x4040_0003_d000_0000ul, $"64{SuffixAvx2}"),
    ];
    var orderConfig = new Dictionary<int, List<FlacLinearPredictionVariantInfo>>() {
        {1, [StandardVariatntInfo]},
        {2, [StandardVariatntInfo]},
        {3, [StandardVariatntInfo]},
        {4, lowOrderVariants},
        {5, lowOrderVariants},
        {6, lowOrderVariants},
        {7, lowOrderVariants},
        {8, lowOrderVariants},
        {9, lowOrderVariants},
    };
    /*for (int i = 2; i <= 13; i++)
    {
        orderConfig[i] = [StandardVariatntInfo];
    }*/
    for (int i = 10; i <= 22; i++)
    {
        orderConfig[i] = midOrderVariants;
    }

    var names32 = c.Select(f => {
        var config = orderConfig.TryGetValue(f, out var c) ? c : highOrderVariants;
        var generate = config.Any(a => a.VariantId == 0x2020_0003_d000_0000ul);
        var callee = config.First(a => a.MultiplyBitsRequired >= 32);
        var order = callee.GetOrderOverride(f);
        return (Order: order, generate, callee);
    }).OrderBy(a => a.Order).ToList();

    var names64 = c.Select(f => {
        var config = orderConfig.TryGetValue(f, out var c) ? c : highOrderVariants;
        var generate = config.Any(a => a.VariantId == 0x4040_0003_d000_0000ul);
        var callee = config.First(a => a.MultiplyBitsRequired >= 64);
        var order = callee.GetOrderOverride(f);
        return (Order: order, generate, callee);
    }).OrderBy(a => a.Order).ToList();

    const string NegativeDebugFlagDescription = "Unsafe.AsPointer<T>(ref T) should only be used in Release mode.";
