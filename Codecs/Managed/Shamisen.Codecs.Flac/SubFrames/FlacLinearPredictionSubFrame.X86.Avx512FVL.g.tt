        {1, [StandardVariatntInfo]},
        {2, [StandardVariatntInfo]},
        {3, [StandardVariatntInfo]},
        {4, lowOrderVariants},
        {5, lowOrderVariants},
        {6, midOrderVariants},
        {7, lowOrderVariants},
    };
    var names = c.Select(f => {
        var config = orderConfig.TryGetValue(f, out var c) ? c : highOrderVariants;
        var generate64 = config.Any(a => a.VariantId == 0x4040_0003_e000_0000ul);
        var generate64Alt = config.Any(a => a.VariantId == 0x4040_0003_e000_0001ul);
        var callee64 = config.First(a => a.MultiplyBitsRequired >= 64);
        return (Order: f, generate64, generate64Alt, callee64);
