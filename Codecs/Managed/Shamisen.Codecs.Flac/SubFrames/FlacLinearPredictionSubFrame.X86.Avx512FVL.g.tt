    List<FlacLinearPredictionVariantInfo> midOrderVariants = [
        /*(52, 64, 0x3440_0003_e017_0000ul, $"52{SuffixIfmaV512}"),*/
        new(0x4040_0003_e000_0001ul, $"64Alt{SuffixAvx512FVL}")
